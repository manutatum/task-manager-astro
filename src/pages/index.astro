---
import AuthLayout from "../layouts/AuthLayout.astro";

import { SignInButton, SignUpButton, Show } from "@clerk/astro/components";

const { isAuthenticated } = Astro.locals.auth();

const title = isAuthenticated ? "Task Manager - Bienvenido" : "Task Manager - Autenticación";
---

<AuthLayout title={title}>
  <h1 class="text-3xl md:text-4xl lg:text-6xl mb-5">Task Manager</h1>

  <p class="text-center text-xl lg:text-2xl mb-5">
    Bienvenido a Task Manager, tu aplicación de gestión de tareas.
  </p>

  <Show when="signed-out">
    <div class="flex flex-col md:flex-row md:justify-center gap-4">
      <SignUpButton
        mode="modal"
        class:list={"btn btn-md md:btn-lg btn-outline"}
        set:text={"Registrarse"}
      />
      <SignInButton
        mode="modal"
        class:list={"btn btn-md md:btn-lg btn-outline"}
        set:text={"Iniciar Sesión"}
      />
    </div>
  </Show>
  <Show when="signed-in">
    <a href="app" class="btn btn-md md:btn-lg btn-outline"> Ir al Dashboard </a>
  </Show>
</AuthLayout>
